# WattWise FRONTEND configuration (copy to .env, then run:  node scripts/generate-env.js  -> writes env.js)
# These values end up in env.js, which is PUBLIC. Never put passwords, API keys or tokens here.
# Backend secrets (DATABASE_URL, MQTT credentials, WEATHERAPI_KEY, SECRET_KEY) belong in Talha's backend .env only.

# Base URL of the FastAPI backend. Leave empty when the backend serves this folder (same origin).
API_BASE_URL=http://localhost:8000
API_PREFIX=/api
REQUEST_TIMEOUT_MS=10000

# Initial data mode for a new browser session: demo | live
DEFAULT_MODE=demo

# Serve backend-shaped MOCK responses in Live mode so the whole service layer can be tested without a backend.
USE_MOCK_API=false
MOCK_LATENCY_MS=250

# Label only (the actual weather location is configured in the backend).
WEATHER_LOCATION_LABEL=Abbottabad
DEBUG=false
